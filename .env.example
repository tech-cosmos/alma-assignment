# Copy to .env (make up does this for you). Every value below is a safe local default;
# docker compose uses the same defaults when no .env exists. Never commit a real .env.

# --- Database -----------------------------------------------------------------
# SQLAlchemy async URL. Host `db` is the Postgres service in docker-compose.yml;
# use localhost:5432 when running the API outside Docker.
DATABASE_URL=postgresql+asyncpg://alma:alma@db:5432/alma

# --- Auth ---------------------------------------------------------------------
# HS256 signing key for the attorney session JWT. Replace outside local dev.
JWT_SECRET=change-me

# --- Attorney login and notification ------------------------------------------
# Recipient of the "new lead" notification email.
ATTORNEY_EMAIL=attorney@example.com
# Email of the single attorney user created by the seed step (login for the internal UI).
SEED_USER_EMAIL=attorney@example.com
# Password for that seeded user.
SEED_USER_PASSWORD=password123

# --- Email adapter ------------------------------------------------------------
# Which email adapter to use: console (log only) | smtp (Mailpit locally) | ses (Amazon SES).
EMAIL_PROVIDER=smtp
# SMTP server host; `mailpit` is the compose service, inbox at http://localhost:8025.
SMTP_HOST=mailpit
# SMTP server port.
SMTP_PORT=1025
# From address on both outgoing emails (must be a verified identity when using SES).
EMAIL_FROM=no-reply@example.com

# --- AWS credentials (only needed for EMAIL_PROVIDER=ses or STORAGE_PROVIDER=s3) --
# Region for SES and S3 clients. For Cloudflare R2 leave as-is or set to `auto`.
AWS_REGION=us-east-1
# Access key for SES/S3/R2. Blank locally.
AWS_ACCESS_KEY_ID=
# Secret key for SES/S3/R2. Blank locally.
AWS_SECRET_ACCESS_KEY=

# --- Storage adapter ----------------------------------------------------------
# Which storage adapter to use for resumes: local (disk) | s3 (AWS S3, Cloudflare R2, MinIO).
STORAGE_PROVIDER=local
# Directory for the local adapter; mounted as the `resumes` volume in docker-compose.yml.
STORAGE_LOCAL_DIR=/data/resumes
# Bucket name for the s3 adapter.
S3_BUCKET=
# Custom S3 endpoint, e.g. https://<account-id>.r2.cloudflarestorage.com for R2. Blank for AWS.
S3_ENDPOINT_URL=

# --- URLs ---------------------------------------------------------------------
# Public URL of the Next.js app; used to build the lead link in the attorney email.
PUBLIC_WEB_URL=http://localhost:3000
# API base URL the browser calls; baked into the Next.js build.
NEXT_PUBLIC_API_URL=http://localhost:8000
