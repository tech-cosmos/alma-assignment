# Browser-visible base URL of the FastAPI service. Inlined at build time.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Set to "true" to run the UI against an in-memory mock of the API (no backend needed).
# Mock login: attorney@example.com / password123
NEXT_PUBLIC_API_MOCK=false

# Name of the httpOnly cookie the API sets on login. middleware.ts checks it to guard /leads.
AUTH_COOKIE_NAME=access_token
