  "cards": [
    {
      "dot": "cyan",
      "title": "Submission path",
      "items": [
        "Router reads at most 5 MB + 1 byte and sniffs PDF / DOC / DOCX magic bytes",
        "LeadService stores the resume, then inserts lead + PENDING event in one transaction",
        "LeadNotifier sends prospect confirmation and attorney notification after the response; failures are logged, never raised"
      ]
    },
    {
      "dot": "rose",
      "title": "Trust boundaries",
      "items": [
        "Public: the form and POST /api/v1/leads only",
        "Authenticated: /leads pages and every other /api/v1/leads route need the access_token cookie or a Bearer JWT",
        "Attorney email links to /leads/{id}; the resume is never attached"
      ]
    },
    {
      "dot": "violet",
      "title": "Adapter ports",
      "items": [
        "EmailAdapter: console | smtp (Mailpit) | ses",
        "StorageAdapter: local (streamed by the API) | s3 (302 to a signed URL, R2 via S3_ENDPOINT_URL)",
        "Provider module loaded by env at first use; tests use fakes"
      ]
    }
  ]
